{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/build/${presetName}/install",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "17",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "MENGINE_ENABLE_VULKAN": "ON",
        "MENGINE_BUILD_SANDBOX": "ON",
        "MENGINE_BUILD_EDITOR": "ON"
      }
    },
    {
      "name": "debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },

    {
      "name": "windows-msvc",
      "hidden": true,
      "inherits": "base",
      "displayName": "Windows (MSVC, Ninja)",
      "description": "MSVC toolchain on Windows. Run from a Developer PowerShell/CMD so cl.exe is on PATH.",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "windows-clang",
      "hidden": true,
      "inherits": "base",
      "displayName": "Windows (Clang, Ninja)",
      "description": "Clang toolchain on Windows. Requires an MSVC-compatible environment on PATH.",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "linux-gcc",
      "hidden": true,
      "inherits": "base",
      "displayName": "Linux (GCC, Ninja)",
      "description": "GCC toolchain on Linux.",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "linux-clang",
      "hidden": true,
      "inherits": "base",
      "displayName": "Linux (Clang, Ninja)",
      "description": "Clang toolchain on Linux.",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "macos",
      "hidden": true,
      "inherits": "base",
      "displayName": "macOS (AppleClang, Ninja)",
      "description": "AppleClang toolchain on macOS.",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },

    {
      "name": "windows-msvc-debug",
      "inherits": ["windows-msvc", "debug"],
      "displayName": "Windows MSVC Debug"
    },
    {
      "name": "windows-msvc-release",
      "inherits": ["windows-msvc", "release"],
      "displayName": "Windows MSVC Release"
    },
    {
      "name": "windows-clang-debug",
      "inherits": ["windows-clang", "debug"],
      "displayName": "Windows Clang Debug"
    },
    {
      "name": "windows-clang-release",
      "inherits": ["windows-clang", "release"],
      "displayName": "Windows Clang Release"
    },
    {
      "name": "linux-gcc-debug",
      "inherits": ["linux-gcc", "debug"],
      "displayName": "Linux GCC Debug"
    },
    {
      "name": "linux-gcc-release",
      "inherits": ["linux-gcc", "release"],
      "displayName": "Linux GCC Release"
    },
    {
      "name": "linux-clang-debug",
      "inherits": ["linux-clang", "debug"],
      "displayName": "Linux Clang Debug"
    },
    {
      "name": "linux-clang-release",
      "inherits": ["linux-clang", "release"],
      "displayName": "Linux Clang Release"
    },
    {
      "name": "macos-debug",
      "inherits": ["macos", "debug"],
      "displayName": "macOS Debug"
    },
    {
      "name": "macos-release",
      "inherits": ["macos", "release"],
      "displayName": "macOS Release"
    }
  ],
  "buildPresets": [
    { "name": "windows-msvc-debug", "configurePreset": "windows-msvc-debug" },
    { "name": "windows-msvc-release", "configurePreset": "windows-msvc-release" },
    { "name": "windows-clang-debug", "configurePreset": "windows-clang-debug" },
    { "name": "windows-clang-release", "configurePreset": "windows-clang-release" },
    { "name": "linux-gcc-debug", "configurePreset": "linux-gcc-debug" },
    { "name": "linux-gcc-release", "configurePreset": "linux-gcc-release" },
    { "name": "linux-clang-debug", "configurePreset": "linux-clang-debug" },
    { "name": "linux-clang-release", "configurePreset": "linux-clang-release" },
    { "name": "macos-debug", "configurePreset": "macos-debug" },
    { "name": "macos-release", "configurePreset": "macos-release" }
  ],
  "testPresets": [
    { "name": "windows-msvc-debug", "configurePreset": "windows-msvc-debug", "output": { "outputOnFailure": true } },
    { "name": "windows-msvc-release", "configurePreset": "windows-msvc-release", "output": { "outputOnFailure": true } },
    { "name": "windows-clang-debug", "configurePreset": "windows-clang-debug", "output": { "outputOnFailure": true } },
    { "name": "windows-clang-release", "configurePreset": "windows-clang-release", "output": { "outputOnFailure": true } },
    { "name": "linux-gcc-debug", "configurePreset": "linux-gcc-debug", "output": { "outputOnFailure": true } },
    { "name": "linux-gcc-release", "configurePreset": "linux-gcc-release", "output": { "outputOnFailure": true } },
    { "name": "linux-clang-debug", "configurePreset": "linux-clang-debug", "output": { "outputOnFailure": true } },
    { "name": "linux-clang-release", "configurePreset": "linux-clang-release", "output": { "outputOnFailure": true } },
    { "name": "macos-debug", "configurePreset": "macos-debug", "output": { "outputOnFailure": true } },
    { "name": "macos-release", "configurePreset": "macos-release", "output": { "outputOnFailure": true } }
  ]
}
